# RDDS Environment Variables Template
# Road Damage Detection System - Group 3 UFV
#
# Instructions: Copy this file to .env and fill in the placeholders with your actual values.
# IMPORTANT: Never commit the .env file to version control — it contains sensitive credentials.

# Database Configuration
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Object Storage (Backblaze B2)
BACKBLAZE_KEY_ID=<backblaze_key_id>
BACKBLAZE_APP_KEY=<backblaze_app_key>
BACKBLAZE_BUCKET=<backblaze_bucket>
# B2 S3-compatible endpoint — change if your bucket is not in us-west-004
BACKBLAZE_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Reproducibility & Training Configuration
RANDOM_SEED=42
SAMPLE_RATIO=0.10

# Dataset Path — set automatically by setup.py to <repo>/data/rdd2022
# Override here if you want the dataset on a different drive (e.g. external disk)
RDD_DATA_ROOT=data/rdd2022
